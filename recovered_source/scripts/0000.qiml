<qiml>
	<group mar="5" text="购买延迟" tip="延迟参数并非越低越好！|过快导致购买随机池开启前点击;过慢会导致错过购买随机池。|受网络条件等设备环境影响，最适合的参数不同，需要自己调整。">
		<row mar="1" hei="10">
		<text text="购买延迟(ms)" wid="360"/>
		<int_edit var="购买延迟" val="840" wid="312" hei="25" tip=""/>
		<text/>
		 </row>
		<row mar="1" hei="10">
			<text text="动态延迟" wid="360"/>
			<check text="开启动态延迟调整（以下设置生效）" var="动态延迟" val="0" wid="312" hei="25" tip=""/>
		<text/>
		</row>
		<row mar="1" hei="10">
			<text text="订单尚未开放购买" wid="360"/>
			<text text="减少" wid="26"/>
		<num_edit var="fd1" val="5" dec="1" wid="25" hei="25" tip="减少延迟"/>
		<text text="毫秒购买延迟(ms)" wid="120"/>
		<text/>
		</row>
		<row mar="1" hei="10">
			<text text="还在公示期（假购买）" wid="360"/>
			<text text="增加" wid="26"/>
		<num_edit var="fd2" val="1" dec="1" wid="25" hei="25" tip="增加延迟"/>
		<text text="毫秒购买延迟(ms)" wid="120"/>
		<text/>
		</row>
		<row mar="1" hei="10">
			<text text="抢购池子已满（未进池）" wid="360"/>
			<text text="减少" wid="26"/>
		<num_edit var="fd4" val="1" dec="1" wid="25" hei="25" tip="减少延迟"/>
		<text text="毫秒购买延迟(ms)" wid="120"/>
		<text/>
		</row>
		<row mar="1" hei="10">
			<text text="被购买或下架（蓝：未进池）" wid="360"/>
			<text text="减少" wid="26"/>
		<num_edit var="fd5" val="1" dec="1" wid="25" hei="25" tip="减少延迟"/>
		<text text="毫秒购买延迟(ms)" wid="120"/>
		<text/>
		</row>
		<row mar="1" hei="10">
			<text text="抢购玩家过多（服务器繁忙）" wid="360"/>
			<text text="减少" wid="26"/>
		<num_edit var="fd6" val="1" dec="1" wid="25" hei="25" tip="减少延迟"/>
		<text text="毫秒购买延迟(ms)" wid="120"/>
		<text/>
		</row>
	</group>
	<group mar="5" text="连点击模式与间隔" tip="开启后连续点击购买按键,可自定义点击间隔。">
		<row mar="1" hei="10">
			<text text="开启连点模式" wid="360"/>
			<check text="连续点击" var="连续点击" val="0" wid="310" hei="25" tip=""/>
			<text/>
		</row>
		<row mar="1" hei="10">
			<text text="点击间隔" wid="360"/>
			<int_edit var="点击间隔" val="30" wid="310" hei="25" tip=""/>
			<text/>
		</row>
	</group>
	<group spc="5" lay="h" text="购买量限制" tip="任意一种品质达到数量即停止 默认0即无限制 |注意：橙色和蓝色计数需关闭跳过摇奖页面否则只计蓝色。">
		<text text="[橙色-紫色-蓝色]" wid="208"/>
		<int_edit var="橙色量" val="0" wid="150" hei="25" tip=""/>
		<int_edit var="紫色量" val="0" wid="150" hei="25" tip=""/>
		<int_edit var="蓝色量" val="0" wid="150" hei="25" tip=""/>
		<text/>
	</group>
	<group mar="5" text="挂机设置" tip="持续运行：执行购买操作后脚本继续运行。|跳过假购买：触发假购买后，再次点击购买刷新跳过。|跳过成功页：购买成功后自动跳过提示界面。|无人挂机时建议全部勾选，且确保已筛选成色和价格范围！">
		<row mar="1">
			<text text="刷新界面" wid="363"/>
			<check text="刷新界面" var="刷新界面" val="0" wid="310" hei="25" tip=""/>
			<text/>
		</row>
		<row mar="1">
			<text text="跳过成功页" wid="363"/>
			<check text="跳过成功页" var="跳过成功页" val="0" wid="310" hei="25" tip=""/>
			<text/>
		</row>
	</group>
	<group mar="5" text="自动收藏模式" tip="开启自动收藏模式：让脚本进行收藏操作">
		<row mar="1">
			<text text="开启自动收藏模式" wid="363"/>
			<check text="开启自动收藏模式" var="开启自动收藏模式" val="0" wid="310" hei="25" tip=""/>
			<text/>
		</row>
		<row mar="1">
			<text text="开启收藏状态OSD" wid="363"/>
			<check text="开启收藏状态OSD" var="开启收藏状态OSD" val="0" wid="310" hei="25" tip=""/>
			<text/>
		</row>
	</group>
